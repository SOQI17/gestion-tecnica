rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Red de seguridad global (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Funciones de verificación de seguridad y roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'alexis.guerra@orimec.com.ec' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    // 2. Healthcheck / Ping de conectividad
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Perfiles de Usuarios (Users)
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Permitir crear su propio perfil al registrarse o si es admin
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Permitir actualizar su propio perfil (sin auto-escalar a admin a menos que sea admin)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // 4. Colección de Ingenieros
    match /engineers/{engineerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 5. Colección de Clientes
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Órdenes de Trabajo (Work Orders)
    match /workOrders/{workOrderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 7. Reportes Técnicos
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 8. Equipos (Equipments)
    match /equipments/{equipmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 9. Contratos (Contracts)
    match /contracts/{contractId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 10. Contratos con GE (ContractsGE)
    match /contractsGE/{contractGeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 11. Vacaciones (Vacations)
    match /vacations/{vacationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 12. Permisos y Compensaciones (Permissions)
    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 13. Cursos y Capacitaciones
    match /cursos/{cursoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /historial_entrenamiento/{historialId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /scheduledTrainings/{trainingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 14. Registros de Mantenimiento (Maintenance Registries)
    match /maintenanceRegistries/{registryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 15. Evaluaciones 360
    match /evaluations360/{evalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 16. Registros de Auditoría Inmutables (Audit Logs)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Inmutable: nadie puede modificar ni borrar logs de auditoría
    }
  }
}
